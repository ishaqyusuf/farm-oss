    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@farm-oss/tsconfig": "workspace:*",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.3",
    "typescript": "^5.9.0",
    "vite": "^7.3.1"
